cabal-version:       3.0
name:                multilib-repro
version:             0.1.0.0
synopsis:            Multilib repro
build-type:          Simple

library
  hs-source-dirs:      src
  exposed-modules:     Dummy
  build-depends:       base
                     , attoparsec
                     -- , attoparsec:attoparsec-internal fails correctly
                     , cassava

                     , io-classes
                     , io-classes:si-timers

--                     , network-can
--                     , network-can:slcan
--                     , network-canopen

  default-language:    Haskell2010
  ghc-options:         -Wall

executable dummy-main
  hs-source-dirs:      .
  main-is:             Main.hs
  build-depends:       base
                     , multilib-repro
                     , io-classes
                     , io-classes:si-timers
